#!/usr/bin/env bash
# start-chicago-wayland: Session launcher for Chicago-Wayland (Windows 95 Native Wayland Desktop)
# Supports standalone DRM/GDM session, --nested window mode, and --headless test mode.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export CHICAGO_REPO_DIR="$REPO_DIR"
RUNTIME_DIR="${CHICAGO_RUNTIME_DIR:-$HOME/.local/share/chicago-wayland/runtime}"
CONFIG_BASE="${XDG_CONFIG_HOME:-$HOME/.config}/chicago-wayland"
LABWC_CFG_DIR="$CONFIG_BASE/labwc"
source "$REPO_DIR/scripts/session-settings.sh"

MODE="session"
STARTUP_CMD=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --nested)
            MODE="nested"
            shift
            ;;
        --headless)
            MODE="headless"
            shift
            ;;
        --startup|-s)
            [[ $# -ge 2 ]] || { echo "--startup requires a command" >&2; exit 2; }
            STARTUP_CMD="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

export PATH="$REPO_DIR/bin:$HOME/.local/bin:$RUNTIME_DIR/usr/bin:$RUNTIME_DIR/usr/libexec:$PATH"
if [[ -d "$RUNTIME_DIR/usr/lib64" ]]; then
    export LD_LIBRARY_PATH="$RUNTIME_DIR/usr/lib64:${LD_LIBRARY_PATH:-}"
fi

export XDG_DATA_DIRS="$HOME/.local/share:$RUNTIME_DIR/usr/share:$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share:/var/lib/snapd/desktop}"
export XCURSOR_PATH="$HOME/.local/share/icons:$HOME/.icons:/usr/share/icons"
export XCURSOR_THEME="Chicago95_Cursor_Black"
export XCURSOR_SIZE="24"
export GTK_THEME="Chicago95"
export GTK_CSD="0"
export ADW_DISABLE_PORTAL="1"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION="1"
export QT_STYLE_OVERRIDE="Windows"
export MOZ_ENABLE_WAYLAND="1"
export ELECTRON_OZONE_PLATFORM_HINT="auto"
export SDL_VIDEODRIVER="wayland"
export KITTY_CONFIG_DIRECTORY="$CONFIG_BASE/kitty"

if [[ ! -d "$LABWC_CFG_DIR" ]]; then
    LABWC_CFG_DIR="$REPO_DIR/config/labwc"
fi

if [[ "$MODE" == "session" ]]; then
    export XDG_CURRENT_DESKTOP="Chicago95:wlroots"
    export XDG_SESSION_DESKTOP="chicago-wayland"
    export XDG_SESSION_TYPE="wayland"
    export CHICAGO_NESTED="0"
    mkdir -p "$STATE_DIR"
    exec 9>"$STATE_DIR/session.lock"
    if ! flock -n 9; then
        echo 'Another standalone Chicago-Wayland session is active.' >&2
        exit 1
    fi
    trap restore_gtk_configs EXIT
    trap '[[ -z "${COMPOSITOR_PID:-}" ]] || kill "$COMPOSITOR_PID" 2>/dev/null || true; exit 130' INT
    trap '[[ -z "${COMPOSITOR_PID:-}" ]] || kill "$COMPOSITOR_PID" 2>/dev/null || true; exit 143' TERM
    trap '[[ -z "${COMPOSITOR_PID:-}" ]] || kill "$COMPOSITOR_PID" 2>/dev/null || true; exit 129' HUP
    apply_session_gtk_configs
elif [[ "$MODE" == "nested" ]]; then
    export CHICAGO_NESTED="1"
elif [[ "$MODE" == "headless" ]]; then
    export CHICAGO_NESTED="1"
    export WLR_BACKENDS="headless"
    export WLR_LIBINPUT_NO_DEVICES="1"
    unset WAYLAND_DISPLAY DISPLAY
fi

LABWC_ARGS=(-C "$LABWC_CFG_DIR")
if [[ -n "$STARTUP_CMD" ]]; then
    LABWC_ARGS+=(-s "$STARTUP_CMD")
fi

if [[ "$MODE" == "session" ]]; then
    labwc "${LABWC_ARGS[@]}" 9>&- &
    COMPOSITOR_PID=$!
    wait "$COMPOSITOR_PID"
else
    exec labwc "${LABWC_ARGS[@]}"
fi

<?xml version="1.0"?>
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
    <autoEnableOutputs>yes</autoEnableOutputs>
    <reuseOutputMode>yes</reuseOutputMode>
    <xwaylandPersistence>no</xwaylandPersistence>
    <primarySelection>yes</primarySelection>
  </core>

  <placement>
    <policy>cascade</policy>
    <cascadeOffset x="24" y="24" />
  </placement>

  <theme>
    <name>Chicago95</name>
    <icon>Chicago95</icon>
    <fallbackAppIcon>application-x-executable</fallbackAppIcon>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>0</cornerRadius>
    <keepBorder>yes</keepBorder>
    <maximizedDecoration>titlebar</maximizedDecoration>
    <dropShadows>no</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <font place="ActiveWindow">
      <name>Helvetica</name>
      <size>11</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>Helvetica</name>
      <size>11</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuHeader">
      <name>Helvetica</name>
      <size>11</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuItem">
      <name>Helvetica</name>
      <size>11</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
    <font place="OnScreenDisplay">
      <name>Helvetica</name>
      <size>11</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
  </theme>

  <focus>
    <followMouse>no</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>

  <windowSwitcher preview="yes" outlines="yes" unshade="yes" order="focus">
    <osd show="yes" style="classic" output="focused" />
    <fields>
      <field content="icon" width="8%" />
      <field content="desktop_entry_name" width="32%" />
      <field content="title" width="60%" />
    </fields>
  </windowSwitcher>

  <resistance>
    <screenEdgeStrength>12</screenEdgeStrength>
    <windowEdgeStrength>12</windowEdgeStrength>
    <unSnapThreshold>20</unSnapThreshold>
    <unMaximizeThreshold>80</unMaximizeThreshold>
  </resistance>

  <snapping>
    <range>
      <inner>10</inner>
      <outer>10</outer>
    </range>
    <cornerRange>40</cornerRange>
    <overlay>
      <enabled>yes</enabled>
      <delay>
        <inner>250</inner>
        <outer>250</outer>
      </delay>
    </overlay>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>

  <resize>
    <popupShow>Nonpixel</popupShow>
    <drawContents>yes</drawContents>
    <minimumArea>8</minimumArea>
  </resize>

  <desktops number="1" popupTime="0">
    <names>
      <name>Windows 95 Desktop</name>
    </names>
  </desktops>

  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="pkill -USR1 chicago-taskbar" />
    </keybind>
    <keybind key="Super_R" onRelease="yes">
      <action name="Execute" command="pkill -USR1 chicago-taskbar" />
    </keybind>
    <keybind key="C-Escape">
      <action name="Execute" command="pkill -USR1 chicago-taskbar" />
    </keybind>
    <keybind key="W-r">
      <action name="Execute" command="chicago-control-panel --run" />
    </keybind>
    <keybind key="W-f">
      <action name="Execute" command="chicago-control-panel --find" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="thunar" />
    </keybind>
    <keybind key="W-c">
      <action name="Execute" command="chicago-control-panel" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="kitty -c /home/sanellathiya/.config/chicago-wayland/kitty/kitty.conf --title 'MS-DOS Prompt'" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="chicago-lock" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Execute" command="chicago-lock" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="pkill -USR2 chicago-taskbar" />
    </keybind>
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="A-Space">
      <action name="ShowMenu" menu="client-menu" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="sh -c 'grim ~/Pictures/chicago95-$(date +%Y%m%d-%H%M%S).png'" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume" allowWhenLocked="yes">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume" allowWhenLocked="yes">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioMute" allowWhenLocked="yes">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp" allowWhenLocked="yes">
      <action name="Execute" command="brightnessctl set +5%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown" allowWhenLocked="yes">
      <action name="Execute" command="brightnessctl set 5%-" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="touchpad">
      <tap>yes</tap>
      <tapButtonMap>lrm</tapButtonMap>
      <clickMethod>clickfinger</clickMethod>
      <naturalScroll>yes</naturalScroll>
      <disableWhileTyping>yes</disableWhileTyping>
    </device>
    <device category="default">
      <naturalScroll>no</naturalScroll>
    </device>
  </libinput>

  <windowRules>
    <windowRule identifier="*" serverDecoration="yes" />
  </windowRules>

</labwc_config>

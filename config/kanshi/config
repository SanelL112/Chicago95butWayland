# Chicago-Wayland Kanshi Multi-Monitor Profiles
# Matches hardware layout: eDP-1 (left), DP-6 HP E22 G5 (center), DP-9 DELL P2222H (right)

profile triple-docked {
    output eDP-1 enable mode 1920x1200@59.95Hz position 0,0 scale 1.0
    output "HP Inc. HP E22 G5 CNK4021C1C" enable mode 1920x1080@74.973Hz position 1920,0 scale 1.0
    output "Dell Inc. DELL P2222H 7KGGCH3" enable mode 1920x1080@60.00Hz position 3840,0 scale 1.0
    exec chicago-power apply-display
}

profile laptop-only {
    output eDP-1 enable mode 1920x1200@59.95Hz position 0,0 scale 1.0
    exec chicago-power apply-display
}
